# PostKing self-hosted renderer — copy this file to .env and fill it in.
# All values are server-only (never NEXT_PUBLIC_) — this app never ships
# your API URL or brand slug to the browser bundle.

# Origin of your PostKing account, no trailing slash. The renderer builds
# /api/landing-pages and /api/blog-posts off this.
POSTKING_API_URL=https://try.postking.app

# Your landing page's slug. Find it in the PostKing dashboard under
# Landing Pages -> your page -> the URL/slug field (also visible in the
# dashboard URL: /dashboard/brands/<brandId>/landing-pages/<slug>).
POSTKING_BRAND_SLUG=

# The public URL this site will be served at once deployed (used for the
# sitemap, canonical URLs, and robots.txt). No trailing slash.
SITE_URL=http://localhost:3000

# Optional. Where relative "/assets/..." paths from PostKing resolve
# against (e.g. a CDN origin). Defaults to POSTKING_API_URL's origin when
# unset — only set this if PostKing told you to use a separate asset/CDN host.
# POSTKING_IMAGE_BASE_URL=
